{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accio Bridge",
  "version": "0.1.0",
  "identifier": "com.accio.gateway.bridge",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": {
      "script": "node ../ui/build.mjs",
      "cwd": "."
    },
    "beforeDevCommand": {
      "script": "node ../ui/build.mjs",
      "cwd": "."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Accio Bridge",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/accio-gateway-bridge-rust"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
